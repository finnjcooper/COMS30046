{
	"version": 6,
	"configurePresets": [
		{
			"name": "make",
			"displayName": "GCC + Make",
			"generator": "Unix Makefiles",
			"binaryDir": "${sourceDir}/../build",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "ninja",
			"displayName": "GCC + Ninja",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/../build",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}
	],
	"buildPresets": [
		{
			"name": "ninja",
			"configurePreset": "ninja"
		},
		{
			"name": "make",
			"configurePreset": "make"
		}
	]
}
