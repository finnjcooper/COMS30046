{
	"version": 6,
	"configurePresets": [
		{
			"name": "default",
			"displayName": "GCC + Ninja",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/../build",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}
	],
	"buildPresets": [
		{
			"name": "default",
			"configurePreset": "default"
		}
	]
}
